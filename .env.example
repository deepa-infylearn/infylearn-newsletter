# --- listmonk (used by compose.yaml) ---
DB_PASSWORD=replace-with-a-long-random-password
# Super admin created on the very first start only.
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=replace-with-a-long-random-password
TZ=Asia/Kolkata

# --- Scripts (npm run setup / plan-issues / import) ---
LISTMONK_URL=http://127.0.0.1:9000
# Create under Admin -> Users -> New -> type "API" (role: Super Admin), then paste here.
LISTMONK_API_USER=automation
LISTMONK_API_TOKEN=

# Public URL people see in links (unsubscribe, archive, subscription form).
ROOT_URL=http://127.0.0.1:9000
FROM_EMAIL=Infylearn Newsletter <newsletter@yourcompany.com>
LIST_NAME=Newsletter

# SMTP used to deliver email. Defaults point at the local Mailpit test inbox.
# Production: your relay (e.g. Amazon SES, Brevo) or self-hosted MTA (e.g. Postal).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# none | plain | login | cram  (use cram for Postal: PLAIN is refused over an unencrypted connection)
SMTP_AUTH=none
# none | STARTTLS | TLS
SMTP_TLS=none

# Twice-a-month schedule used by plan-issues: days of month and local send time.
ISSUE_DAYS=1,15
ISSUE_TIME=10:00

# Optional: screen imports through the Email Checker app before adding them.
EMAIL_CHECKER_URL=
EMAIL_CHECKER_USER=
EMAIL_CHECKER_PASSWORD=
